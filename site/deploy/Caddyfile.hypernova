# Hypernova's site, https://hypernova.nikbraun.tech: static files from /var/www/hypernova
# (site/dist from `node site/build.mjs`, plus download/ and media/ that the release puts there).
# Include it from the main Caddyfile (`import /etc/caddy/Caddyfile.hypernova`) or paste it in,
# then `caddy validate --config /etc/caddy/Caddyfile` and `systemctl reload caddy`.

hypernova.nikbraun.tech {
	root * /var/www/hypernova

	# build.mjs writes .br and .gz beside every text file; anything else is compressed on the fly.
	encode zstd gzip
	file_server {
		precompressed br gzip
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		# Every script, style, font and image is a file on this site; nothing inline, nothing third-party.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
		-Server
	}

	# Caching: fingerprinted assets never change; pages and the release's latest.json are checked
	# every time; the downloads keep their names across releases, so they revalidate too.
	@hashed path_regexp hashed ^/assets/.+\.[0-9a-f]{10}\.[a-z0-9]+$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@pages path / *.html */ /404.html
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	@latest path /download/latest.json
	header @latest Cache-Control "no-cache"

	@crawl path /sitemap.xml /robots.txt /llms.txt /llms-full.txt /favicon.ico /favicon.svg /apple-touch-icon.png /og.jpg /assets/fonts/*.txt
	header @crawl Cache-Control "public, max-age=3600"

	@media path /media/*
	header @media Cache-Control "public, max-age=86400"

	# The downloads: their own types, saved rather than opened, revalidated (same name every release).
	# Byte ranges (resumed downloads, seeking in the film) work by default.
	@dmg path /download/*.dmg
	header @dmg {
		Content-Type "application/x-apple-diskimage"
		Content-Disposition "attachment"
		Cache-Control "no-cache"
	}
	@apk path /download/*.apk
	header @apk {
		Content-Type "application/vnd.android.package-archive"
		Content-Disposition "attachment"
		Cache-Control "no-cache"
	}
	@tgz path /download/*.tar.gz
	header @tgz {
		Content-Type "application/gzip"
		Content-Disposition "attachment"
		Cache-Control "no-cache"
	}
	@ehpk path /download/*.ehpk
	header @ehpk {
		Content-Type "application/octet-stream"
		Content-Disposition "attachment"
		Cache-Control "no-cache"
	}
	@sums path /download/*.txt
	header @sums {
		Content-Type "text/plain; charset=utf-8"
		Cache-Control "no-cache"
	}

	# The styled 404 for anything that isn't there.
	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
		handle {
			respond "{err.status_code} {err.status_text}"
		}
	}
}

# Uncomment only once a www record points here too (Caddy would keep asking for its certificate).
# www.hypernova.nikbraun.tech {
# 	redir https://hypernova.nikbraun.tech{uri} permanent
# }
