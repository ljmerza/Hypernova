<?xml version="1.0" encoding="utf-8"?>
<!-- drawable/widget_bg.xml plus the app's film grain. Only on Android 12+, where the widget's
     root is clipped to the card's rounded outline: the grain tile itself is square and would
     show in the corners otherwise. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient
                android:angle="270"
                android:centerColor="#E01B1814"
                android:endColor="#EB1B1814"
                android:startColor="#E6221F1B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient
                android:centerX="0.9"
                android:centerY="0.0"
                android:endColor="#007FFFA0"
                android:gradientRadius="80%p"
                android:startColor="#127FFFA0"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/widget_grain_tile"
            android:tileMode="repeat" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <stroke
                android:width="1dp"
                android:color="#14F5F2EB" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top|fill_horizontal"
        android:left="@dimen/widget_radius"
        android:right="@dimen/widget_radius">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#40F5F2EB"
                android:endColor="#00F5F2EB"
                android:startColor="#00F5F2EB" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="bottom|fill_horizontal"
        android:left="@dimen/widget_radius"
        android:right="@dimen/widget_radius">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#1FF5F2EB"
                android:endColor="#00F5F2EB"
                android:startColor="#00F5F2EB" />
        </shape>
    </item>
</layer-list>
