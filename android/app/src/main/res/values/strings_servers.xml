<?xml version="1.0" encoding="utf-8"?>
<!-- Several paired computers (data/Servers.kt, ui/home/ServerSwitcher.kt). "Mac" reads "server" on a Linux one (data/ComputerWords.kt). -->
<resources>
    <!-- The switcher: the Home chip's sheet. -->
    <string name="servers_title">Paired computers</string>
    <string name="servers_switch_label">Switch to %1$s</string>
    <string name="servers_on_screen">On screen</string>
    <string name="servers_pair_another">Add a server</string>
    <string name="servers_chip_label">Choose a Mac</string>
    <!-- TalkBack on the chip, named while not linked (several paired): "z2, Offline". -->
    <string name="link_said_named">%1$s, %2$s</string>
    <!-- The chip's amber count: sessions on the other computers that need you. -->
    <plurals name="servers_elsewhere">
        <item quantity="one">%d needs you on another Mac</item>
        <item quantity="other">%d need you on another Mac</item>
    </plurals>

    <!-- "All servers": Home shows every paired computer's sessions together (ui/home/AllHome.kt). -->
    <string name="servers_all">All servers</string>
    <!-- Automations with "All servers": they stay one server's. -->
    <string name="all_servers_no_automations">Automations are one server\'s: pick a server to see them.</string>
    <!-- History with "All servers": the servers not linked, named (z2, gym). -->
    <plurals name="history_all_offline">
        <item quantity="one">%1$s is offline: its sessions are as last seen, and the words inside them aren\'t searched.</item>
        <item quantity="other">%1$s are offline: their sessions are as last seen, and the words inside them aren\'t searched.</item>
    </plurals>
    <string name="servers_all_label">Show every server\'s sessions together</string>
    <!-- The chip while Home shows all of them, and what TalkBack hears. -->
    <string name="servers_all_chip">All</string>
    <string name="servers_all_said">All servers</string>
    <plurals name="servers_all_said_down">
        <item quantity="one">All servers, %d not linked</item>
        <item quantity="other">All servers, %d not linked</item>
    </plurals>
    <!-- A card's tag in its meta line: its server's name, and "offline" while that one isn't linked. -->
    <string name="servers_tag_offline">%1$s offline</string>
    <!-- New session from "All servers": which server first. -->
    <string name="servers_new_on">New session on</string>
    <string name="servers_new_on_label">New session on %1$s</string>
    <!-- Statistics while Home shows all servers: whose they are, before the days they cover. -->
    <string name="stats_on_server">%1$s · %2$s</string>

    <!-- A notification from one of several computers: its name under the title (data/Core.kt, Notifier). -->
    <string name="notif_server_from_agent">%1$s, from %2$s</string>
    <string name="notif_server_from_an_agent">%1$s, from an agent</string>
    <!-- The permanent notification's title with others watched under it. -->
    <string name="notif_title_watched">%1$s · +%2$d watched</string>

    <!-- Settings with "All servers" (ui/settings/SettingsPlan.kt): each server's block under its name, then this phone's. -->
    <string name="st_all_phone">This phone</string>
    <!-- In a server's block while it isn't connected: its other settings are left out until it is. -->
    <string name="st_all_waiting">Its settings show here once it\'s connected.</string>
</resources>
