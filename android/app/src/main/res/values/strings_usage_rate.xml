<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- How the plan's windows are spent is drawn (ui/components/ProjectionMeter.kt): a meter's used
         fill, its pace's faint fill, a red notch when the limit comes before the reset. In words only
         for TalkBack, one sentence per meter. %1$s names the window ("5-hour window"), %2$d is its
         percent, %3$s the pace like 0.8 or 0.05, the last ones durations like 47m or 2h 1m. -->
    <string name="usage_said_limit">%1$s %2$d%% used, spending %3$s%% a minute: at this pace you reach the limit in about %4$s, before the reset in %5$s.</string>
    <string name="usage_said_safe">%1$s %2$d%% used, spending %3$s%% a minute: at this pace it lasts until the reset in %4$s.</string>
    <string name="usage_said_idle">%1$s %2$d%% used, resets in %3$s.</string>
    <string name="usage_said_plain">%1$s %2$d%% used.</string>
    <string name="usage_said_full">%1$s: limit reached, resets in %2$s.</string>
    <string name="usage_said_full_plain">%1$s: limit reached.</string>
    <!-- The same, when the meter shows the reset as a day and time (a model's own week): the last
         argument is usage_reset_day_at ("Tuesday at 3:56 PM"), so it never says "resets in Tue 3:56 PM". -->
    <string name="usage_said_limit_at">%1$s %2$d%% used, spending %3$s%% a minute: at this pace you reach the limit in about %4$s, before the reset on %5$s.</string>
    <string name="usage_said_safe_at">%1$s %2$d%% used, spending %3$s%% a minute: at this pace it lasts until the reset on %4$s.</string>
    <string name="usage_said_idle_at">%1$s %2$d%% used, resets on %3$s.</string>
    <string name="usage_said_full_at">%1$s: limit reached, resets on %2$s.</string>
    <string name="usage_reset_day_at">%1$s at %2$s</string>
    <string name="usage_name_five">5-hour window</string>
    <string name="usage_name_seven">Weekly window</string>
    <string name="usage_name_model">%1$s week</string>
    <!-- The chat strip's compact meter: the 5-hour window's short label. -->
    <string name="usage_five_short">5h</string>
</resources>
