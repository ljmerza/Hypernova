<?xml version="1.0" encoding="utf-8"?>
<!-- Statistics: how much Claude worked on the Mac (ui/stats/, docs/PROTOCOL.md "Statistics"). A tap on the sun opens it.
     With Codex at work in the range (or leading), the hero, streak, footer and loading line take strings_stats_agents.xml's words. -->
<resources>
    <string name="stats_title">Statistics</string>
    <!-- The second line of the sun's readout, once, until Statistics is first opened. -->
    <string name="sun_stats_hint">Tap the sun for your statistics</string>
    <!-- TalkBack: the sky's action, and the hint's. -->
    <string name="a11y_open_stats">Open statistics</string>

    <!-- The range switcher. -->
    <string name="stats_range_today">Today</string>
    <string name="stats_range_week">Week</string>
    <string name="stats_range_month">Month</string>
    <string name="stats_range_ytd">YTD</string>
    <string name="stats_range_all">All</string>
    <!-- Under the title: the days the range covers ("9 – 15 Oct", "since 1 Jan", "since 13 Oct 2026"). -->
    <string name="stats_span">%1$s – %2$s</string>
    <string name="stats_since">since %1$s</string>

    <!-- Durations: Claude's working time ("34h 26m", "152h", "26m"). -->
    <string name="stats_hm">%1$dh %2$dm</string>
    <string name="stats_h">%1$dh</string>
    <string name="stats_m">%1$dm</string>
