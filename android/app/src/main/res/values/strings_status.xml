<?xml version="1.0" encoding="utf-8"?>
<!-- The status bar above the prompt box while a turn runs (ui/session/StatusBar.kt). -->
<resources>
    <string name="status_starting">Starting</string>
    <string name="status_sending">Sending</string>
    <string name="status_thinking">Thinking</string>
    <string name="status_writing">Writing the reply</string>
    <string name="status_working">Working</string>
    <string name="status_retrying">%1$s</string>
    <string name="status_reading">Reading %1$s</string>
    <string name="status_reading_many">Reading %1$d files</string>
    <string name="status_searching">Searching %1$s</string>
    <string name="status_editing">Editing %1$s</string>
    <string name="status_creating">Creating %1$s</string>
    <string name="status_running">Running %1$s</string>
    <string name="status_fetching">Fetching %1$s</string>
    <string name="status_searching_web">Searching the web for %1$s</string>
    <string name="status_planning">Updating the to-do list</string>
    <string name="status_tool">Using %1$s</string>
    <!-- A running workflow, by its script's name: "review-changes", its tally beside it ("1/7"). -->
    <string name="status_workflow">%1$s</string>
    <plurals name="status_agents">
        <item quantity="one">%1$d agent working</item>
        <item quantity="other">%1$d agents working</item>
    </plurals>
    <string name="status_wait_approve">Waiting for you: approve %1$s</string>
    <string name="status_wait_answer">Waiting for you: answer a question</string>
    <string name="status_wait_plan">Waiting for you: review the plan</string>
    <string name="status_wait_you">Waiting for you</string>
    <string name="status_failed">Stopped on an error</string>

    <string name="status_stop">Stop</string>
    <string name="status_stop_desc">Stop %1$s</string>
    <string name="status_expand">Show the to-do list</string>
    <string name="status_fold">Fold the to-do list</string>
    <string name="status_expand_agents">Show the workflow\'s agents</string>
    <string name="status_fold_agents">Fold the workflow\'s agents</string>
    <string name="status_open">Open</string>
    <string name="status_folded">Folded</string>
    <!-- TalkBack: what the bar reads. %1$s is the sentence above, so no full stop of its own. -->
    <string name="status_desc_todos">%1$s. %2$d of %3$d to-dos done. %4$s elapsed</string>
    <string name="status_desc_plain">%1$s. %2$s elapsed</string>
    <!-- While a workflow runs: its name, then its agents finished (done, failed or stopped) of those it has started so far. -->
    <!-- The last argument is the workflow's time and tokens: "19 minutes elapsed, 181 thousand tokens". -->
    <string name="status_desc_workflow_only">Workflow %1$s, %2$d of %3$d agents finished. %4$s</string>
    <string name="status_desc_workflow">%1$s. Workflow %2$s, %3$d of %4$d agents finished. %5$s</string>
    <string name="status_run_said">%1$s elapsed</string>

    <!-- With no workflow, while the main agent's agents work, as Claude Code's footer lists them:
         "main + 3 agents" folded; opened, the main agent and a row per agent. -->
    <plurals name="status_main_agents">
        <item quantity="one">main + %1$d agent</item>
        <item quantity="other">main + %1$d agents</item>
    </plurals>
    <plurals name="status_main_agents_said">
        <item quantity="one">Main agent and %1$d agent at work</item>
        <item quantity="other">Main agent and %1$d agents at work</item>
    </plurals>
    <!-- The main agent's own row: its name as Claude Code's footer has it, and what it does while it waits. -->
    <string name="status_main">main</string>
    <string name="status_main_waiting">Waiting for its agents</string>
    <string name="status_expand_main">Show the main agent and its agents</string>
    <string name="status_fold_main">Fold the agents</string>
    <!-- Tokens as Claude Code's footer writes them: "↓ 181.1k" folded, "↓ 81.2k tokens" on an agent's row. -->
    <string name="status_tokens_short">↓ %1$s</string>
    <string name="status_tokens_figure">↓ %1$s tokens</string>
    <!-- The to-dos' tally, folded and as a heading over the opened checklist: "TO-DO 7/10" (upper-cased in code). -->
    <string name="status_todo_label">To-do</string>
    <string name="status_todo_heading_said">To-do list, %1$d of %2$d done</string>
    <!-- TalkBack: how long and how many tokens ("4 minutes, 81 thousand tokens"). -->
    <plurals name="status_seconds_said">
        <item quantity="one">%1$d second</item>
        <item quantity="other">%1$d seconds</item>
    </plurals>
    <plurals name="status_tokens_said_units">
        <item quantity="one">%1$d token</item>
        <item quantity="other">%1$d tokens</item>
    </plurals>
    <string name="status_tokens_said_thousands">%1$s thousand tokens</string>
    <string name="status_tokens_said_millions">%1$s million tokens</string>

    <!-- The workflow's agents, opened: each agent's state in a word, or what it does now while it runs. -->
    <string name="status_agent_running">running</string>
    <string name="status_agent_done">done</string>
    <!-- TalkBack, one agent: "survey:daemon, done"; "implement:fix, running: Edit: agents.ts". -->
    <string name="status_agent_said">%1$s, %2$s</string>
    <string name="status_agent_said_doing">%1$s, running: %2$s</string>
</resources>
