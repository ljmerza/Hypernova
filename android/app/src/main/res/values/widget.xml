    <color name="widget_ink_ghost">#FF43444F</color>
    <color name="widget_line">#FF252A3A</color>
    <color name="widget_bg">#FF060A17</color>
    <color name="widget_accent">#FF6FE0C2</color>
    <color name="widget_amber">#FFFFA63C</color>
