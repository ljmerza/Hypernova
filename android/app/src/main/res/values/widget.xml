<resources>
    <!-- Home screen widgets. The launcher draws them, not Compose, so the app's tokens
         (ui/theme/Tokens.kt) are repeated here as resources. -->
    <color name="widget_ink">#FFF5F2EB</color>
    <color name="widget_ink_muted">#FFB5B0A6</color>
    <color name="widget_ink_dim">#FF7A7468</color>
    <color name="widget_ink_ghost">#FF45403A</color>
    <color name="widget_line">#FF2C2823</color>
    <color name="widget_bg">#FF14110E</color>
    <color name="widget_accent">#FF7FFFA0</color>
    <color name="widget_amber">#FFE8B341</color>
    <color name="widget_danger">#FFFF7878</color>

    <!-- Android 12+ takes the launcher's own widget radii (values-v31). -->
    <dimen name="widget_radius">16dp</dimen>
    <dimen name="widget_inner_radius">10dp</dimen>
</resources>
