<!-- Home's usage cards with two agents (data/AgentLead.kt).
     A Mac with Claude Code alone shows none of these. -->
<resources>
    <!-- The ongoing notification's title where Codex is the only agent and can't reply. -->
    <string name="notif_codex_signed_out">Codex is signed out on %1$s</string>
    <string name="notif_codex_limited">Codex’s usage limit is reached</string>

    <!-- Home's usage cards while both agents are in use: each says whose it is. -->
    <string name="usage_claude">Claude usage</string>
    <string name="usage_name_five_claude">Claude 5-hour window</string>
    <string name="usage_name_seven_claude">Claude weekly window</string>
    <!-- Where Codex leads (no Claude Code on the Mac), its usage card before Codex is turned on. -->
    <string name="cx_usage_off">Your first Codex session turns Codex on. Its limits show after that.</string>
</resources>
