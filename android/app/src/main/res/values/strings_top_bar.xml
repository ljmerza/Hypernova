<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The session's top bar on the chat screen (ui/session/UsageStrip.kt, TopBar.kt). -->
    <plurals name="top_bar_agents">
        <item quantity="one">%d agent</item>
        <item quantity="other">%d agents</item>
    </plurals>
    <string name="top_bar_agents_open">Show the agents</string>
    <!-- TalkBack: this turn's time so far ("This turn: 4:05 so far."). -->
    <string name="top_bar_turn_said">This turn: %1$s so far.</string>
    <!-- The week's pace: the day of the week, then its use less the share of the week gone ("Day 2/7 +10%"). -->
    <string name="top_bar_week_pace">Day %1$d/7 %2$s</string>
    <plurals name="top_bar_week_pace_over_said">
        <item quantity="one">Day %1$d of 7, %2$d point over an even week.</item>
        <item quantity="other">Day %1$d of 7, %2$d points over an even week.</item>
    </plurals>
    <plurals name="top_bar_week_pace_under_said">
        <item quantity="one">Day %1$d of 7, %2$d point under an even week.</item>
        <item quantity="other">Day %1$d of 7, %2$d points under an even week.</item>
    </plurals>
    <string name="top_bar_week_pace_even_said">Day %1$d of 7, level with an even week.</string>
    <!-- Git: after session_sheet_branch_said ("Branch main."). -->
    <string name="top_bar_git_worktree_said">In worktree %1$s.</string>
    <plurals name="top_bar_git_lines_said">
        <item quantity="one">%1$d line added and %2$d removed.</item>
        <item quantity="other">%1$d lines added and %2$d removed.</item>
    </plurals>

