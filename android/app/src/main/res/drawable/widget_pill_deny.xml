<?xml version="1.0" encoding="utf-8"?>
<!-- Deny: the danger pill, red text on a red hairline. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FF7878">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#0FFF7878" />
            <stroke
                android:width="1dp"
                android:color="#66FF7878" />
        </shape>
    </item>
</ripple>
