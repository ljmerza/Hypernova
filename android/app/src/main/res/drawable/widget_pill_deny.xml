<?xml version="1.0" encoding="utf-8"?>
<!-- Deny: the danger pill, red text on a red hairline. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33EE4468">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#0FEE4468" />
            <stroke
                android:width="1dp"
                android:color="#66EE4468" />
        </shape>
    </item>
</ripple>
