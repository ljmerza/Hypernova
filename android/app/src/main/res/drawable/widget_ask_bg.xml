<?xml version="1.0" encoding="utf-8"?>
<!-- The approval block (ApprovalBlock in the app): near-black with a breath of amber and an
     amber ring at 45%. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_inner_radius" />
            <solid android:color="#E60F0D0A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_inner_radius" />
            <solid android:color="#0DE8B341" />
            <stroke
                android:width="1dp"
                android:color="#73E8B341" />
        </shape>
    </item>
</layer-list>
