<?xml version="1.0" encoding="utf-8"?>
<!-- widget_meter_mint past 80%: amber, as the app's meters turn. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/background"
        android:height="1dp"
        android:gravity="center_vertical|fill_horizontal">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_line" />
        </shape>
    </item>
    <!-- The pace: a faint fill on to where it leads by the reset (the app's projection meter). -->
    <item android:id="@android:id/secondaryProgress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="1.5dp" />
                <solid android:color="@color/widget_amber_pace" />
            </shape>
        </scale>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="1.5dp" />
                <solid android:color="@color/widget_amber" />
            </shape>
        </scale>
    </item>
</layer-list>
