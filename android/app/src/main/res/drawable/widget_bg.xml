<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's card: plain, in the app's colours. The warm near-black at 92% (a wallpaper behind
     it is busier than the sky) and a hairline ring at ink 8%. No nebula, no grain (2026-10-31). On
     Android 12+ the corners are the launcher's own (values-v31). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <solid android:color="#EB1B1814" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <stroke
                android:width="1dp"
                android:color="#14F5F2EB" />
        </shape>
    </item>
</layer-list>
