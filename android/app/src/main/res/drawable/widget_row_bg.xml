<!-- A row of the list: a faint ink fill (4%) with a hairline ring (ink 8%), a soft ink ripple when pressed. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1AF1E9D6">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_inner_radius" />
            <solid android:color="#0AF1E9D6" />
            <stroke
                android:width="1dp"
                android:color="#14F1E9D6" />
        </shape>
    </item>
</ripple>
