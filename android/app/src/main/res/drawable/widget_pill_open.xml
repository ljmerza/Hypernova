<!-- Open: the outline pill, for questions and plans, which are answered in the app. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33F1E9D6">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#4D181B26" />
            <stroke
                android:width="1dp"
                android:color="#38F1E9D6" />
        </shape>
    </item>
</ripple>
