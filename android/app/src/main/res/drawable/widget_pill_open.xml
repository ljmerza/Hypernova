<?xml version="1.0" encoding="utf-8"?>
<!-- Open: the outline pill, for questions and plans, which are answered in the app. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33F5F2EB">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#4D221F1B" />
            <stroke
                android:width="1dp"
                android:color="#38F5F2EB" />
        </shape>
    </item>
</ripple>
