<?xml version="1.0" encoding="utf-8"?>
<!-- The large widget: a seam (the activity planet, who's working, a hairline, the Mac's name),
     the approval that waits for you, up to four sessions, and the usage meters with the sun. The
     approval and the rows are added in code (WidgetViews), as many as the widget's size fits. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp"
    tools:targetApi="31">

    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_meter"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/w_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.18"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/widget_ink_muted"
            android:textFontWeight="600"
            android:textSize="10sp" />

        <FrameLayout
            android:id="@+id/w_hairline"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@color/widget_line" />

        <TextView
            android:id="@+id/w_trail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.09"
            android:maxWidth="200dp"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/widget_ink_dim"
            android:textFontWeight="600"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/w_stale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink_dim"
            android:textSize="10.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_ask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- The sun, in the room the rest leaves: with nothing in orbit (no sessions, or no Mac) it
         stands alone with one quiet line about why; on a tall widget it sits above the sessions,
         as the sky sits above the list in the app. -->
    <LinearLayout
        android:id="@+id/w_hero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <!-- The star takes what the lines under it leave (a second weight: one measure more, once per update). -->
        <ImageView
            android:id="@+id/w_hero_star"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            tools:ignore="NestedWeights" />

        <TextView
            android:id="@+id/w_hero_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink_muted"
            android:textFontWeight="500"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/w_hero_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink_dim"
            android:textFontWeight="500"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <!-- Takes the room that's left, so the meters sit on the bottom edge. -->
    <FrameLayout
        android:id="@+id/w_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/w_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_star"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="-6dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/w_five"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:screenReaderFocusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/w_five_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.18"
                    android:maxLines="1"
                    android:text="@string/five_hours"
                    android:textAllCaps="true"
                    android:textColor="@color/widget_ink_dim"
                    android:textFontWeight="600"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/w_five_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- The bar, the app's projection meter: used solid, the pace a faint fill on to where it
                 leads by the reset, and a red notch at the end when that's the limit, first. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:layout_marginTop="2dp">

                <ProgressBar
                    android:id="@+id/w_five_mint"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="center_vertical"
                    android:max="1000"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:progressDrawable="@drawable/widget_meter_mint" />

                <ProgressBar
                    android:id="@+id/w_five_amber"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="center_vertical"
                    android:max="1000"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:progressDrawable="@drawable/widget_meter_amber"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/w_five_danger"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="center_vertical"
                    android:max="1000"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:progressDrawable="@drawable/widget_meter_danger"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/w_five_notch"
                    android:layout_width="2dp"
                    android:layout_height="9dp"
                    android:layout_gravity="end"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_notch"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- The one tag: the reset after its glyph, or the limit's time in red after a notch. -->
            <LinearLayout
                android:id="@+id/w_five_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/w_five_glyph"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_glyph_reset" />

                <TextView
                    android:id="@+id/w_five_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink_dim"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_seven"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:screenReaderFocusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/w_seven_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.18"
                    android:maxLines="1"
                    android:text="@string/seven_days"
                    android:textAllCaps="true"
                    android:textColor="@color/widget_ink_dim"
                    android:textFontWeight="600"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/w_seven_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- The bar, the app's projection meter: used solid, the pace a faint fill on to where it
                 leads by the reset, and a red notch at the end when that's the limit, first. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:layout_marginTop="2dp">

                <ProgressBar
                    android:id="@+id/w_seven_mint"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="center_vertical"
                    android:max="1000"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:progressDrawable="@drawable/widget_meter_mint" />

                <ProgressBar
                    android:id="@+id/w_seven_amber"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="center_vertical"
                    android:max="1000"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:progressDrawable="@drawable/widget_meter_amber"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/w_seven_danger"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="center_vertical"
                    android:max="1000"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:progressDrawable="@drawable/widget_meter_danger"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/w_seven_notch"
                    android:layout_width="2dp"
                    android:layout_height="9dp"
                    android:layout_gravity="end"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_notch"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- The one tag: the reset after its glyph, or the limit's time in red after a notch. -->
            <LinearLayout
                android:id="@+id/w_seven_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/w_seven_glyph"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_glyph_reset" />

                <TextView
                    android:id="@+id/w_seven_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink_dim"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- The other agent while both are in use (Codex next to Claude Code), a compact readout after
             the meters: its name in their tracked caps over its percentage (red 100% at its limit, an
             amber dash when it's signed out or in trouble). The spacer under it stands where the
             meters' tags are, so the three line up; it goes with them in the slim footer. Shown only
             where the meters keep their room (WidgetViews.footer). -->
        <LinearLayout
            android:id="@+id/w_other"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            android:screenReaderFocusable="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/w_other_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:letterSpacing="0.18"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/widget_ink_dim"
                android:textFontWeight="600"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/w_other_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="monospace"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_other_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="10dp"
                android:text=" "
                android:textSize="10sp"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
