<?xml version="1.0" encoding="utf-8"?>
<!-- widget_row with more air, for a widget tall enough that four rows would leave a gap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/r_root"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:background="@drawable/widget_row_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingEnd="2dp">

    <ImageView
        android:id="@+id/r_planet"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="-5dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/r_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textFontWeight="500"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/r_project"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:maxWidth="110dp"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/widget_ink_dim"
                android:textFontWeight="600"
                android:textSize="9sp" />

            <!-- A Codex session while both agents are in use: CODEX after the project, a step
                 brighter than it. Gone otherwise. -->
            <TextView
                android:id="@+id/r_agent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:text="@string/cx_agent_codex"
                android:textAllCaps="true"
                android:textColor="@color/widget_ink_muted"
                android:textFontWeight="600"
                android:textSize="9sp"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/r_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
