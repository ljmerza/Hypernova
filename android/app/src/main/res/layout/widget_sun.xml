<?xml version="1.0" encoding="utf-8"?>
<!-- The small widget, square: the sun (5-hour usage) over its meter and who's working.
     Launcher widgets can't load the app's fonts (RemoteViews inflate in a restricted context),
     so the system's sans at Manrope's weights stands in, and monospace for numbers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/w_star"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="yes"
        android:scaleType="fitCenter" />

    <!-- The readout: the 5-hour window as a projection meter (its percentage, the bar with its
         pace and, when the limit comes first, the red notch, then one tag: the reset after its
         glyph, or the limit's time in red), or one line of words ("refills 16:40"). TalkBack hears
         the star's sentence, which says all of it. -->
    <LinearLayout
        android:id="@+id/w_meter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_readout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/w_bar"
            android:layout_width="0dp"
            android:layout_height="9dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/w_bar_mint"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="center_vertical"
                android:max="1000"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:progressDrawable="@drawable/widget_meter_mint" />

            <ProgressBar
                android:id="@+id/w_bar_amber"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="center_vertical"
                android:max="1000"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:progressDrawable="@drawable/widget_meter_amber"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/w_bar_notch"
                android:layout_width="2dp"
                android:layout_height="9dp"
                android:layout_gravity="end"
                android:src="@drawable/widget_notch"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/w_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/w_tag_glyph"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_glyph_reset" />

            <TextView
                android:id="@+id/w_tag_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink_dim"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- The other agent while both are in use (Codex next to Claude Code): its name in the meters'
         tracked caps and its percentage, small, under the readout ("CODEX 61%"; red 100% at its
         limit, an amber dash when it's signed out or in trouble). TalkBack hears it in the star's
         sentence. Gone otherwise. -->
    <LinearLayout
        android:id="@+id/w_other"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/w_other_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.18"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/widget_ink_dim"
            android:textFontWeight="600"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/w_other_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:breakStrategy="balanced"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:textColor="@color/widget_ink_muted"
        android:textFontWeight="500"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_ink_dim"
        android:textFontWeight="500"
        android:textSize="10.5sp"
        android:visibility="gone" />
</LinearLayout>
