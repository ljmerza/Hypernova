<?xml version="1.0" encoding="utf-8"?>
<!-- The approval that waits for you, as the session screen shows it: the amber NEEDS YOU band
     (project, tool), the exact command, and Deny / Allow right on the widget. Questions and
     plans get Open instead: they need the app to answer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/a_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/widget_ask_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:background="@drawable/widget_ask_band"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/a_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.18"
            android:maxLines="1"
            android:text="@string/state_needs_you"
            android:textAllCaps="true"
            android:textColor="@color/widget_bg"
            android:textFontWeight="700"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/a_project"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#B314110E"
            android:textFontWeight="600"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/a_tool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.18"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#B314110E"
            android:textFontWeight="700"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/a_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/a_command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_command_bg"
            android:breakStrategy="simple"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:hyphenationFrequency="none"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:textColor="@color/widget_ink"
            android:textSize="12sp" />

        <!-- A question or a plan reads as prose, not as a command. -->
        <TextView
            android:id="@+id/a_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:maxLines="2"
            android:paddingTop="2dp"
            android:textColor="@color/widget_ink"
            android:textFontWeight="500"
            android:textSize="13.5sp"
            android:visibility="gone" />

        <!-- The buttons' touch targets are 44dp tall around 32dp pills, so the margins above and
             below are 6dp less than they look. The line keeps that height while the buttons are
             gone ("Allowing…"), so the block doesn't jump. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/a_note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink_dim"
                android:textFontWeight="500"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/a_deny"
                android:layout_width="wrap_content"
                android:layout_height="44dp">

                <TextView
                    android:id="@+id/a_deny_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/widget_pill_deny"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="72dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/deny"
                    android:textColor="@color/widget_danger"
                    android:textFontWeight="600"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/a_allow"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/a_allow_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/widget_pill_allow"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="72dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/allow"
                    android:textColor="@color/widget_bg"
                    android:textFontWeight="600"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/a_open"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/a_open_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/widget_pill_open"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="72dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/widget_open"
                    android:textColor="@color/widget_ink"
                    android:textFontWeight="600"
                    android:textSize="13sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
