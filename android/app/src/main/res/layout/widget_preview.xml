<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview (Android 12+, previewLayout): the widget as it looks, with generic
     sample data and no clock time. Static: the real one's list comes from WidgetListService. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp"
    tools:targetApi="31">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.18"
            android:text="@string/state_needs_you"
            android:textAllCaps="true"
            android:textColor="@color/widget_ink_muted"
            android:textFontWeight="600"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_count"
            android:textColor="@color/widget_amber"
            android:textFontWeight="600"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@color/widget_line" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:letterSpacing="0.14"
        android:paddingStart="4dp"
        android:text="@string/widget_preview_server"
        android:textAllCaps="true"
        android:textColor="@color/widget_ink_dim"
        android:textFontWeight="600"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="9dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textColor="@color/widget_ink"
            android:textFontWeight="500"
            android:textSize="13.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:text="@string/widget_preview_tool"
            android:textAllCaps="true"
            android:textColor="@color/widget_amber"
            android:textFontWeight="700"
            android:textSize="9.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/widget_command_bg"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:text="@string/widget_preview_command"
            android:textColor="@color/widget_ink"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/widget_pill_deny"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="68dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/deny"
                android:textColor="@color/widget_danger"
                android:textFontWeight="600"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_pill_allow"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="68dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/allow"
                android:textColor="@color/widget_bg"
                android:textFontWeight="600"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
