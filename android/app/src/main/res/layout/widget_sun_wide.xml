<?xml version="1.0" encoding="utf-8"?>
<!-- The small widget stretched sideways (one row tall, or wide): the sun at the left, its
     readout and who's working beside it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp"
    tools:targetApi="31">

    <!-- As tall as the widget, and as wide as it is tall (the star is square). -->
    <ImageView
        android:id="@+id/w_star"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:importantForAccessibility="yes"
        android:maxWidth="128dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- The readout: the 5-hour window as a projection meter (its percentage, the bar with its
             pace and, when the limit comes first, the red notch, then one tag: the reset after its
             glyph, or the limit's time in red), or one line of words ("refills 16:40"). TalkBack hears
         the star's sentence, which says all of it. -->
        <LinearLayout
            android:id="@+id/w_meter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_readout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/w_bar"
                android:layout_width="0dp"
                android:layout_height="9dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/w_bar_mint"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="center_vertical"
                    android:max="1000"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:progressDrawable="@drawable/widget_meter_mint" />

                <ProgressBar
                    android:id="@+id/w_bar_amber"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="center_vertical"
                    android:max="1000"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:progressDrawable="@drawable/widget_meter_amber"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/w_bar_notch"
                    android:layout_width="2dp"
                    android:layout_height="9dp"
                    android:layout_gravity="end"
                    android:src="@drawable/widget_notch"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/w_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/w_tag_glyph"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_glyph_reset" />

                <TextView
                    android:id="@+id/w_tag_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink_dim"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- The other agent while both are in use ("CODEX 61%"), at the end of the readout's row:
                 it gives way before the bar does (WidgetViews.sun). Gone otherwise. -->
            <LinearLayout
                android:id="@+id/w_other"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/w_other_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.18"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/widget_ink_dim"
                    android:textFontWeight="600"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/w_other_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/w_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink_muted"
            android:textFontWeight="500"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink_dim"
            android:textFontWeight="500"
            android:textSize="10.5sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
