<?xml version="1.0" encoding="utf-8"?>
<!-- The small widget: the sun. 2×2 by default; one cell shows only the sun, a wide row puts the
     words beside it. No update period: the app pushes every real change itself, and redraws a
     picture that goes out of date by itself (a reset passing) with a non-waking alarm
     (WidgetSync.schedule). A period would wake the phone every half hour to redraw what's known. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_sun_desc"
    android:initialLayout="@layout/widget_sun"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/widget_preview_sun"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
