<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Approvals that arrive while the app is in the background (Android 13+ asks first). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The always-on link to the paired Mac (see ConnectionService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The background connection comes back after the phone restarts (BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Voice: the mic in the composer, only between a press and the end (asked at the first press);
         Android's on-device recognizer hears it, on the phone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Read aloud: the CPU stays up while the phone plays a reply with the screen off, for that play only. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The in-app update (data/AppUpdater.kt): the APK the paired computer hands out, installed with
         PackageInstaller after Android's own "Update this app?" (and, once, "Install unknown apps"). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The fingerprint or screen lock before Always, Bypass, No asking and browsing outside the
         projects folder (ui/components/OwnerCheck.kt): without it BiometricPrompt throws. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <queries>
        <!-- Fork: the phone's own speech recognizer (data/PhoneDictation.kt), when the Mac offers no voice. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:name=".HypernovaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hypernova">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Fork: no https://hypernova.observer App Link (an autoVerify filter would make Android
                 fetch that site's assetlinks.json at install). Pairing is local only: the QR code
                 opens the server's own pairing page on the network, which hands over to the link below. -->

            <!-- The app link, hypernova://pair?v=1&u=…&c=…&n=…: the server's pairing page's hand-over, Paste link, adb. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hypernova" android:host="pair" />
            </intent-filter>
            <!-- Long-press on the icon: New session and the latest projects (ui/share/LauncherShortcuts). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <!-- Share to Hypernova: text, links, pictures and files from any app's share sheet. It asks
             where they go, puts them in that composer and opens the app there (ui/share). -->
        <activity
            android:name=".ui.share.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/Theme.Hypernova"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <!-- Photos taken with the camera app for an attachment (in the app's cache). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Holds the WebSocket to the user's own Mac while it's paired, so approval requests
             from Claude Code reach the phone at once. specialUse: dataSync is capped at 6 h/day. -->
        <service
            android:name=".ConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a live connection to the user's own Mac (over their home network or their own VPN into it) so that permission requests from coding sessions running there reach the phone immediately and can be answered." />
        </service>
        <!-- Home screen widgets (widget/): the sun, and the sessions with their approvals. Only the
             system sends them updates, so they aren't exported. -->
        <receiver
            android:name=".widget.SunWidget"
            android:exported="false"
            android:label="@string/widget_sun_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sun_info" />
        </receiver>
        <receiver
            android:name=".widget.SessionsWidget"
            android:exported="false"
            android:label="@string/widget_sessions_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sessions_info" />
        </receiver>
        <!-- Allow and Deny on the sessions widget, and the widgets' alarm (WidgetSync.schedule):
             reached only through their own PendingIntents. -->
        <receiver
            android:name=".widget.WidgetActions"
            android:exported="false" />
        <!-- PackageInstaller's answers about the in-app update (its own PendingIntent), and this app
             being replaced by it, which a quiet notification then says (data/AppUpdater.kt). -->
        <receiver
            android:name=".data.UpdateStatusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- After a restart of the phone, or an update of this app: the background connection again
             (BootReceiver), while a computer is paired and "Stay connected" is on. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Allow and Deny on an approval's notification, and Reply on a session's (data/NotifyActions.kt):
             reached only through the notifications' own PendingIntents, after the phone is unlocked. -->
        <receiver
            android:name=".data.NotifyActions"
            android:exported="false" />
    </application>
</manifest>
