{
  "name": "hypernova-lens",
  "private": true,
  "version": "0.1.12",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5177",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test test/*.test.ts",
    "shots": "python3 test/sim-shots.py shots/sim shot:glance && node test/phone-shots.mjs shots/phone",
    "whitelist": "node scripts/whitelist.mjs",
    "simulate": "evenhub-simulator http://127.0.0.1:5177/?demo=1 --automation-port 9917",
    "qr": "evenhub qr --http --port 5177",
    "pack": "node scripts/whitelist.mjs && npm run build && evenhub pack app.local.json dist -o out.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^26.6.4",
    "playwright": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "8.3.3",
    "ws": "^8.22.0"
  }
}
