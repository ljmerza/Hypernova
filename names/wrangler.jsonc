// Wrangler configuration for the hypernova.observer name service.
// `setup.sh` fills in the two ids marked FILL-IN; everything else is final.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hypernova-names",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // No *.workers.dev address: the service answers only on its own domain, so the page and the
  // API cannot be reached (or indexed) under a second name.
  "workers_dev": false,

  // Custom domains: Wrangler creates the proxied DNS records for these two hosts on deploy and
  // Cloudflare issues their certificates. Nothing else in the zone is proxied.
  "routes": [
    { "pattern": "api.hypernova.observer", "custom_domain": true },
    { "pattern": "hypernova.observer", "custom_domain": true }
  ],

  "vars": {
    "DOMAIN": "hypernova.observer",
    // The zone id from the dashboard's overview page (not a secret; the token is).
    "CF_ZONE_ID": "FILL-IN-ZONE-ID",
    // The Android app's signing certificates (SHA-256, as `keytool -list -v` prints them), comma-
    // separated: /.well-known/assetlinks.json lets https://<DOMAIN>/pair and /glasses open the app
    // (src/links.ts). The first is the build Mac's debug key (the debug APK); the second the release
    // key's (`./gradlew :app:distRelease`, docs/RELEASING.md). Takes effect on the next deploy.
    "ANDROID_CERT_FINGERPRINTS": "AD:02:C8:A9:F1:19:BE:D5:56:5F:9D:B5:2C:DD:EA:13:85:F9:B0:F4:7A:52:1E:38:2E:F4:3A:BD:5F:6A:82:8B,FC:07:0D:B2:14:89:38:DF:C1:80:A6:01:DC:62:42:1E:AD:8E:F1:0D:98:B5:A0:60:6E:C9:20:89:A5:92:6A:2A"
  },
  // CF_API_TOKEN is a secret: `npx wrangler secret put CF_API_TOKEN` (see setup.md).

  // D1 rather than KV: it is strongly consistent, which replay protection and rate limits need,
  // and its free tier allows far more writes per day.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hypernova-names",
      "database_id": "FILL-IN-DATABASE-ID",
      "migrations_dir": "migrations"
    }
  ],

  // Hourly maintenance: expired challenge records, names idle for 90 days, orphaned records.
  "triggers": { "crons": ["17 * * * *"] },

  "observability": { "enabled": true }
}
