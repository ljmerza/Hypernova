      "id": "home",
      "name": "~"
    },
    {
      "id": "folder-app-parser-fix",
      "name": "app-parser-fix"
    },
    {
      "id": "folder-notebook",
      "name": "notebook"
    },
    {
      "id": "folder-sketchpad",
      "name": "sketchpad"
    },
    {
      "id": "folder-demo",
      "name": "demo"
    },
    {
      "id": "folder-app",
      "name": "app"
    }
  ]
}
